<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ReservationSystem</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ReservationSystem.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables/jquery.dataTables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/jquery-ui/themes/base/jquery-ui.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/datatables-responsive/responsive.dataTables.min.css" asp-append-version="true" />

</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-sm navbar-light bg-primary-subtle border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-truck h3"> Asset Reservation </i></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Employee" asp-controller="Home" asp-action="MyReservations">Moje rezerwacje</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Employee" asp-controller="Home" asp-action="Reserved">Wszystkie rezerwacje</a>
                        </li>

                        @if (User.IsInRole(SD.Role_Manager))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link text-dark dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Zarządzanie
                                </a>
                                <ul class="dropdown-menu">
                                    <li class="nav-item">
                                        <a class="dropdown-item" asp-area="Manager" asp-controller="Asset" asp-action="Index">Samochody</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="nav-item">
                                        <a class="dropdown-item" asp-area="Manager" asp-controller="Reservation" asp-action="Index">Rezerwacje</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="nav-item">
                                        <a class="dropdown-item" asp-area="Manager" asp-controller="Fault" asp-action="Index">Usterki</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="nav-item">
                                        <a class="dropdown-item" asp-area="Manager" asp-controller="Feedback" asp-action="Index">Historia feedbacków</a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole(SD.Role_Admin))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link text-dark dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Zarządzanie
                                </a>
                                <ul class="dropdown-menu">
                                    <li class="nav-item">
                                        <a class="dropdown-item" asp-area="Manager" asp-controller="Asset" asp-action="Index">Samochody</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="nav-item">
                                        <a class="dropdown-item" asp-area="Manager" asp-controller="Reservation" asp-action="Index">Rezerwacje</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="nav-item">
                                        <a class="dropdown-item" asp-area="Manager" asp-controller="Fault" asp-action="Index">Usterki</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="nav-item">
                                        <a class="dropdown-item" asp-area="Manager" asp-controller="Feedback" asp-action="Index">Historia feedbacków</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="nav-item">
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="User" asp-action="Index">Użytkownicy</a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li class="nav-item">
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="UserGroup" asp-action="Index">Grupy użytkowników</a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        <div class="container-fluid px-4">
            <partial name="_NotificationPartial" />
            @RenderBody()
        </div>
    </main>

    <footer class="border-top bg-primary-subtle text-muted">
        <div class="container">
            &copy; 2025 - ReservationSystem
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-ui/jquery-ui.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/lib/datatables-responsive/dataTables.responsive.min.js" asp-append-version="true"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js" asp-append-version="true"></script>
    <script src="~/lib/toastr/toastr.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
