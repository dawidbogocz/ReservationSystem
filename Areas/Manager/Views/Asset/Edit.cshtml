@model AssetVM

<div class="card shadow border-0 mt-4">
	<div class="card-header bg-secondary bg-gradient ml-0 py-3">
		<div class="row">
			<div class="col-12 text-center">
				<h2 class="text-white py-2">Edit Asset</h2>
			</div>
		</div>
	</div>
	<div class="card-body p-4">
		<form method="post" class="row" enctype="multipart/form-data">
			<input asp-for="@Model.Asset.ImageUrl" hidden />
			<div class="row">
				<div class="col-12">
					<div class="border p-3 mt-2">
						<div class="form-floating py-2 col-12">
							<input asp-for="@Model.Asset.AssetTag" class="form-control border-0 shadow" />
							<label asp-for="@Model.Asset.AssetTag" class="ms-2">Asset Tag</label>
							<span asp-validation-for="@Model.Asset.AssetTag" class="text-danger"></span>
						</div>

						<div class="form-floating py-2 col-12">
							<select asp-for="Asset.AssetType" class="form-select border-0 shadow">
								<option value="Default">Default</option>
							</select>
							<label asp-for="Asset.AssetType" class="ms-2">Asset type</label>
						</div>

						<div class="form-floating py-2 col-12">
							<input asp-for="@Model.Asset.Make" class="form-control border-0 shadow" />
							<label asp-for="@Model.Asset.Make" class="ms-2">Make</label>
							<span asp-validation-for="@Model.Asset.Make" class="text-danger"></span>
						</div>

						<div class="form-floating py-2 col-12">
							<input asp-for="@Model.Asset.Model" class="form-control border-0 shadow" />
							<label asp-for="@Model.Asset.Model" class="ms-2">Model</label>
							<span asp-validation-for="@Model.Asset.Model" class="text-danger"></span>
						</div>

						<div class="form-floating py-2 col-12">
							<input asp-for="@Model.Asset.InspectionDate" class="form-control border-0 shadow" type="date" />
							<label asp-for="@Model.Asset.InspectionDate" class="ms-2">Inspection</label>
							<span asp-validation-for="@Model.Asset.InspectionDate" class="text-danger"></span>
						</div>

						<div class="form-floating py-2 col-12">
							<input asp-for="@Model.Asset.ServiceDate" class="form-control border-0 shadow" type="date" />
							<label asp-for="@Model.Asset.ServiceDate" class="ms-2">Service</label>
							<span asp-validation-for="@Model.Asset.ServiceDate" class="text-danger"></span>
						</div>

						<div class="form-check form-switch py-2 col-12">
							<input asp-for="@Model.Asset.IsDamaged" class="form-check-input" type="checkbox" />
							<label asp-for="@Model.Asset.IsDamaged" class="form-check-label">Is the asset damaged?</label>
						</div>
						<div class="form-check form-switch py-2 col-12">
							<input asp-for="@Model.Asset.HasTelemetry" class="form-check-input" type="checkbox" />
							<label asp-for="@Model.Asset.HasTelemetry" class="form-check-label">Does the asset have telemetry?</label>
						</div>

						<div class="form-floating py-2 col-12">
							<input type="file" name="file" class="form-control border-0 shadow" />
							<label asp-for="@Model.Asset.ImageUrl" class="ms-2">Photo</label>
						</div>

						<div class="form-floating py-2 col-12">
							<input asp-for="Asset.UsageCount" class="form-control border-0 shadow" min="0" />
							<label asp-for="Asset.UsageCount" class="ms-2">Usage count</label>
							<span asp-validation-for="Asset.UsageCount" class="text-danger"></span>
						</div>

						<div class="py-2 col-12" id="conditionSection">
							<label class="form-label" asp-for="Asset.ConditionLevel" id="conditionLabel">Condition [%]</label>
							<input type="range" asp-for="Asset.ConditionLevel" class="form-range" min="0" max="100" oninput="updateCondition(this.value)">
							<div class="progress" style="height:20px;">
								<div id="conditionBar" class="progress-bar bg-success" role="progressbar" style="width:50%">50%</div>
							</div>
							<span asp-validation-for="Asset.ConditionLevel" class="text-danger"></span>
						</div>

						<div class="row pt-2">
							<div class="col-6 col-md-3">
								<button type="submit" class="btn btn-primary form-control">Edit</button>
							</div>
							<div class="col-6 col-md-3">
								<a asp-area="Manager" asp-controller="Asset" asp-action="Index" class="btn btn-outline-primary border form-control">Cancel</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	@{
		<partial name="_ValidationScriptsPartial" />
	}
	<script>
		function updateCondition(val){
			const bar = document.getElementById('conditionBar');
			bar.style.width = val + '%';
			bar.innerText   = val + '%';

			if (val < 25)      bar.className = 'progress-bar bg-danger';
			else if (val < 60) bar.className = 'progress-bar bg-warning';
			else               bar.className = 'progress-bar bg-success';
		}
	</script>

}
