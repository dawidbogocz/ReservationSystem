@using System.Security.Claims;
@model List<Asset>

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">Asset List</h2>
            </div>


            <div class="row mt-3">
                <div class="col-md-7 d-flex flex-wrap gap-2">
                    <select id="makeFilter" class="form-select w-auto">
                        <option value="">Make (all)</option>
                        @foreach (var mk in Model.Select(c => c.Make).Distinct().OrderBy(m => m))
                        {
                            <option value="@mk">@mk</option>
                        }
                    </select>

                    <select id="conditionFilter" class="form-select w-auto">
                        <option value="">Condition (all)</option>
                        <option value="Uszkodzony">Damaged</option>
                        <option value="Dobry">Good</option>
                    </select>

                    <select id="telemetryFilter" class="form-select w-auto">
                        <option value="">Telemetry (all)</option>
                        <option value="Tak">Yes</option>
                        <option value="Nie">No</option>
                    </select>
                </div>

                <div class="col-md-5 text-end">
                    <button id="exportBtn" class="btn btn-success me-2">
                        <i class="bi bi-file-earmark-excel"></i> Excel
                    </button>
                    <a asp-area="Manager" asp-controller="Asset" asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Add Asset
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        @if (Model.Any(asset => asset.InspectionDate < DateOnly.FromDateTime(DateTime.Now)))
        {
            <div class="alert alert-warning" role="alert">
                Warning: One or more assets have an expired inspection date!
            </div>
        }
        @if (Model.Any(asset => asset.ServiceDate < DateOnly.FromDateTime(DateTime.Now)))
        {
            <div class="alert alert-warning">
                Warning: One or more assets have an expired service date!
            </div>
        }


        <table id="assetTable" class="table table-bordered table-striped table-responsive" cellspacing="0" width="100%">
            <thead>
                <tr>
                    <th>Photo</th>
                    <th>Asset Tag</th>
                    <th>Asset type</th>
                    <th>Make</th>
                    <th>Model</th>
                    <th>Inspection date</th>
                    <th>Service date</th>
                    <th>Faults</th>
                    <th>Condition</th>
                    <th>Telemetry</th>
                    <th>Usage count</th>
                    <th>Condition (%)</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var obj in Model)
                {
                    <tr class="@(obj.InspectionDate < DateOnly.FromDateTime(DateTime.Now) ? "table-danger" : "")">
                        <td class="w-25">
                            <img class="img-fluid img-thumbnail rounded mx-auto d-block" src="@obj.ImageUrl" style="border-radius:5px; border:1px solid #bbb9b9" />
                        </td>
                        <td>@obj.AssetTag</td>
						<td>@obj.AssetType</td>
                        <td>@obj.Make</td>
                        <td>@obj.Model</td>
                        <td>@obj.InspectionDate.ToString("dd-MM-yyyy")</td>
                        <td>@obj.ServiceDate.ToString("dd-MM-yyyy")</td>
                        <td>
                            @if (obj.Faults != null && obj.Faults.Any())
                            {
                                bool tmp = true;
                                @foreach (var fault in obj.Faults)
                                {
                                    if (!fault.IsFixed)
                                    {
                                        tmp = true;
                                        <ul>
                                            <li>@fault.Description</li>
                                        </ul>
                                    }
                                    else
                                    {
                                        tmp = false;
                                    }
                                }
                                if (!tmp)
                                {
<span>No faults</span>
                            }
                        }
                        else
                        {
                            <span>No faults</span>
                            }
                        </td>
                        <td>
                            @(obj.IsDamaged ? "Damaged" : "Good")
                        </td>
                        <td>
                            @(obj.HasTelemetry ? "Yes" : "No")
                        </td>
                        <td>@obj.UsageCount</td>
                        <td>@obj.ConditionLevel</td>
                        <td>
                            <div class="d-flex flex-wrap">
                                <a asp-area="Manager" asp-controller="Asset" asp-action="Edit" asp-route-id="@obj.AssetTag" class="btn btn-outline-primary mt-2 mx-2 flex-grow-1">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <button type="button" onclick="deleteAsset('@obj.AssetTag')" class="btn btn-outline-danger mt-2 mx-2 flex-grow-1">
                                    <i class="bi bi-trash3"></i> Delete
                                </button>
                                <a asp-area="Manager" asp-controller="Fault" asp-action="Upsert" asp-route-assetTag="@obj.AssetTag" asp-route-userId="@User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier)" class="btn btn-outline-info mt-2 mx-2 w-100">
                                    <i class="bi bi-plus-circle"></i> Add fault
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#assetTable').DataTable({
                responsive: true,
                paging: true,
                searching: true,
                ordering: true,
                lengthMenu: [5, 10, 25, 50],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ assets",
                    zeroRecords: "No matching assets found",
                    info: "Showing _START_ to _END_ of _TOTAL_ assets",
                    infoEmpty: "No assets available",
                    infoFiltered: "(filtered from _MAX_ assets)",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                }
            });
        });

        $('#makeFilter' ).on('change', function () {
            $('#assetTable').DataTable().column(2).search($('#makeFilter').val()).draw()
        });
        $('#conditionFilter').on('change', function () {
            $('#assetTable').DataTable().column(7).search($('#conditionFilter').val()).draw()
        });
        $('#telemetryFilter').on('change', function () {
            $('#assetTable').DataTable().column(8).search($('#telemetryFilter').val()).draw()
        });

        $('#exportBtn').on('click', function () {
            const qs = $.param({
                make:  $('#makeFilter').val(),
                condition:  $('#conditionFilter').val(),
                telemetry:    $('#telemetryFilter').val()
            });
            window.location = `/Manager/Asset/ExportToExcel?${qs}`;
        });


        function deleteAsset(assetTag) {
            Swal.fire({
                title: 'Delete confirmation',
                text: 'Are you sure you want to delete this asset?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/Manager/Asset/DeleteAsset/${assetTag}`,
                        type: "DELETE",
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Success', response.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'An error occurred while processing the request.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}