@model FaultVM

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white py-2">
                    @(Model.Fault.Id != 0 ? "Edit" : "Add") Fault
                </h2>
            </div>
        </div>
    </div>

    <div class="card-body p-4">
        <form method="post">
            <input asp-for="Fault.Id" hidden />

            <div class="border p-3 mt-4">

                <div class="form-floating py-2 col-12">
                    <select asp-for="Fault.AssetTag" asp-items="@Model.AssetList" class="form-select border-0 shadow">
                        <option disabled selected>--Select Asset--</option>
                    </select>
                    <label class="ms-2">Asset Tag</label>
                </div>

                <div class="form-floating py-2 col-12">
                    <select asp-for="Fault.UserId" asp-items="@Model.UserList" class="form-select border-0 shadow">
                        <option disabled selected>--Select user--</option>
                    </select>
                    <label class="ms-2">Reported by</label>
                </div>

                <div class="form-floating py-2 col-12">
                    <input asp-for="Fault.Description" class="form-control border-0 shadow" />
                    <label class="ms-2">Description</label>
                </div>

                <div class="form-check py-2 col-12">
                    <input asp-for="Fault.IsFixed" class="form-check-input" id="isFixedCheckbox" />
                    <label class="form-check-label ms-2">Is it fixed?</label>
                </div>

                <div class="form-check py-2 col-12">
                    <input asp-for="Fault.IsDrivable" class="form-check-input" />
                    <label class="form-check-label ms-2">
                        Vehicle is usable despite the fault
                    </label>
                </div>

                <div class="form-floating py-2 col-12">
                    <textarea asp-for="Fault.DrivableComment"
                              class="form-control border-0 shadow"
                              style="height: 80px;"></textarea>
                    <label class="ms-2">Admin comment</label>
                </div>

                <div class="form-floating py-2 col-12">
                    <textarea asp-for="Fault.FixDescription"
                              class="form-control border-0 shadow"
                              style="height: 100px;"></textarea>
                    <label class="ms-2">Fix description</label>
                </div>

                @if (Model.Fault.Id != 0)
                {
                    <div class="form-floating py-2 col-12">
                        <input value="@Model.Fault.DateReported.ToString("yyyy-MM-dd HH:mm")"
                               class="form-control border-0 shadow" readonly />
                        <label class="ms-2">Date reported</label>
                    </div>
                }

                <div id="fixDateContainer" class="form-floating py-2 col-12">
                    <input asp-for="Fault.FixDate"
                           type="date"
                           class="form-control border-0 shadow" />
                    <label class="ms-2">Fix date</label>
                </div>

                <div class="row pt-2">
                    <div class="col-6 col-md-3">
                        <button type="submit" class="btn btn-primary form-control">
                            @(Model.Fault.Id != 0 ? "Edit" : "Add")
                        </button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-area="Manager" asp-controller="Fault" asp-action="Index"
                           class="btn btn-outline-primary border form-control">
                            Cancel
                        </a>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleFixDate() {
            const checkbox = document.getElementById('isFixedCheckbox');
            const container = document.getElementById('fixDateContainer');
            const dateInput = document.getElementById('Fault_FixDate');

            if (checkbox.checked) {
                container.style.display = 'block';

                if (!dateInput.value) {
                    const today = new Date().toISOString().split('T')[0];
                    dateInput.value = today;
                }
            } else {
                container.style.display = 'none';
                dateInput.value = "";
            }
        }

        document.addEventListener("DOMContentLoaded", toggleFixDate);
        document.getElementById('isFixedCheckbox')
            .addEventListener("change", toggleFixDate);
    </script>
}
