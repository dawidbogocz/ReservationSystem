@model ReservationApp.Models.ApplicationUser

@{
    ViewData["Title"] = "Dodaj użytkownika";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="FirstName" class="form-label">Imie</label>
        <input asp-for="FirstName" class="form-control" required />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label">Nazwisko</label>
        <input asp-for="LastName" class="form-control" required />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" type="email" required />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

	<div class="mb-3">
		<label asp-for="PhoneNumber" class="form-label">Numer telefonu</label>
		<input asp-for="PhoneNumber" class="form-control" required />
		<span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label for="role" class="form-label">Rola</label>
        <select name="role" class="form-select">
            <option value="">Wybierz rolę</option>
            <option value="Admin">Admin</option>
            <option value="Manager">Manager</option>
            <option value="Employee">Employee</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="UserGroupId" class="form-label">Grupa / dział</label>
        <select asp-for="UserGroupId" asp-items="ViewBag.GroupList" class="form-select">
            <option value="">-- brak grupy --</option>
        </select>
        <span asp-validation-for="UserGroupId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Zapisz</button>
    <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
</form>
