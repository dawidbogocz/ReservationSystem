@model IEnumerable<ReservationApp.Models.ApplicationUser>

@{
    ViewData["Title"] = "User List";
}

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient py-3">
        <h2 class="text-white py-2 text-center">User List</h2>
        <div class="col-12 text-end mt-3">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add User
            </a>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="table-responsive mt-3">
            <table id="userTable" class="table table-bordered table-striped" cellspacing="0" width="100%">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>First name</th>
                        <th>Last name</th>
                        <th>Email</th>
                        <th>Phone number</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#userTable').DataTable({
                "ajax": {
                    "url": "/Admin/User/GetAll",
                    "type": "GET",
                    "datatype": "json",
                    "dataSrc": "data"
                },
                "columns": [
                    { "data": "id" },
                    { "data": "username" },
                    { "data": "firstName" },
                    { "data": "lastName" },
                    { "data": "email" },
					{ "data": "phoneNumber" },
                    {
                        "data": "id",
                        "render": function (data) {
                            return `<a href="/Admin/User/Edit/${data}" class="btn btn-outline-primary mt-2 mx-2">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <button onclick="deleteUser('${data}')" class="btn btn-outline-danger mt-2 mx-2">
                                        <i class="bi bi-trash3"></i> Delete
                                    </button>`;
                        }
                    }
                ],
                "language": {
                    "lengthMenu": "Show _MENU_ users",
                    "zeroRecords": "No matching users",
                    "info": "Showing _START_ to _END_ of _TOTAL_ users",
                    "infoEmpty": "No users available",
                    "search": "Search:",
                    "paginate": {
                        "first": "First",
                        "last": "Last",
                        "next": "Next",
                        "previous": "Previous"
                    },
                },
                "processing": true,
                "serverSide": false,
                "responsive": true,
                "paging": true,
                "searching": true,
                "ordering": true,
                "lengthMenu": [10, 15, 25, 50]
            });
        });


        function deleteUser(id) {
            Swal.fire({
                title: 'Delete Confirmation',
                text: 'Are you sure you want to delete this user?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, delete',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/Admin/User/Delete/${id}`,
                        type: "DELETE",
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Success', response.message, 'success')
                                .then(() => {
                                    $('#userTable').DataTable().ajax.reload();
                                });
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'An error occurred while processing the request.', 'error');
                        }
                    });
                }
            });
        }

    </script>
}

