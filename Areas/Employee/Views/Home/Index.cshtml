@model IEnumerable<ReservationApp.Models.Asset>

@{
    var notifications = ViewBag.ReminderNotifications as List<string>;
}

@if (notifications != null && notifications.Any())
{
    foreach (var note in notifications)
    {
        <div class="alert alert-info" role="alert">
            @note
        </div>
    }
}

<div class="container mt-4">
    <h2 class="text-center mb-4 text-primary">Available Assets</h2>

    <!-- Date Filter Section -->
    <div class="row justify-content-center mb-4">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow border-0">
                <div class="card-body">
                    <form method="get" id="dateFilterForm" class="d-flex align-items-center justify-content-between">
                        <div class="form-group me-3">
                            <label for="startDate" class="form-label text-secondary">Start date:</label>
                            <input type="datetime-local" id="startDate" name="startDate" class="form-control"
                                   value="@ViewBag.StartDate.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                        <div class="form-group me-3">
                            <label for="endDate" class="form-label text-secondary">End date:</label>
                            <input type="datetime-local" id="endDate" name="endDate" class="form-control"
                                   value="@ViewBag.EndDate.ToString("yyyy-MM-ddTHH:mm")" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Assets Display Section -->
    <div class="row">
        @foreach (var asset in Model)
        {
            /* — rezerwacje — */
            bool hasReservationConflict = asset.Reservations.Any(r =>
            (r.Approval == Approval.Pending || r.Approval == Approval.Accepted) &&
            (r.PickupDate < ViewBag.EndDate && r.ReturnDate > ViewBag.StartDate));

            var activeReservation = asset.Reservations.FirstOrDefault(r =>
            (r.Approval == Approval.Pending || r.Approval == Approval.Accepted) &&
            (r.PickupDate < ViewBag.EndDate && r.ReturnDate > ViewBag.StartDate));

            /* — blocking faults — */
            var blockingFaults = asset.Faults?.Where(f => !f.IsFixed && !f.IsDrivable).ToList() ?? new();
            bool hasBlockingFaults = blockingFaults.Any();

            bool isAvailable = !hasReservationConflict && !hasBlockingFaults;

            <div class="col-12 col-sm-6 col-md-4 col-lg-3 mb-4">
                <div class="card border-0 shadow rounded h-100 d-flex flex-column @(isAvailable ? "" : "bg-light text-muted")">
                    <img src="@asset.ImageUrl" class="card-img-top rounded asset-image" alt="Asset Image" />
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="card-title text-center text-primary">@asset.AssetTag</h5>
                            <p class="text-center text-muted small">Type: @(asset.AssetType == AssetType.Default ? "Default" : asset.AssetType.ToString())</p>
                            <p class="text-secondary text-center mb-1"><strong>Make:</strong> @asset.Make</p>
                            <p class="text-secondary text-center mb-1"><strong>Model:</strong> @asset.Model</p>
                            <p class="text-secondary text-center mb-1"><strong>Inspection:</strong> @asset.InspectionDate.ToString("dd-MM-yyyy")</p>
                            <p class="text-secondary text-center mb-1"><strong>Service:</strong> @asset.ServiceDate.ToString("dd-MM-yyyy")</p>

                            <p class="text-secondary text-center mb-1"><strong>Usage count:</strong> @asset.UsageCount.ToString("N0")</p>
                            @if (asset.AssetType == AssetType.Default)
                            {
                                <div class="mb-2 text-center">
                                    <label><strong>Condition:</strong></label>
                                    <div class="progress" style="height:20px;">
                                        <div class="progress-bar @(asset.ConditionLevel < 25 ? "bg-danger" : asset.ConditionLevel < 60 ? "bg-warning" : "bg-success")" role="progressbar" style="width:@asset.ConditionLevel%">
                                            @asset.ConditionLevel%
                                        </div>
                                    </div>
                                </div>
                            }

                            <p class="text-secondary text-center mb-3"><strong>Condition:</strong> @(asset.IsDamaged ? "Damaged" : "Good")</p>

                            @if (asset.HasTelemetry)
                            {
                                <div class="text-center mb-2">
                                    <span class="badge bg-success"><i class="bi bi-camera-video"></i> Telemetry</span>
                                </div>
                            }

                            @if (!isAvailable && activeReservation != null)
                            {
                                <hr />
                                <p class="text-danger text-center mb-1"><strong>Reserved by:</strong></p>
                                <p class="text-center mb-1">@activeReservation.User.FirstName @activeReservation.User.LastName</p>
                                <p class="text-center mb-1">📞 @activeReservation.User.PhoneNumber</p>
                                <p class="text-center small">
                                    <strong>From:</strong> @activeReservation.PickupDate.ToString("dd-MM-yyyy HH:mm")<br />
                                    <strong>To:</strong> @activeReservation.ReturnDate.ToString("dd-MM-yyyy HH:mm")
                                </p>
                            }

                            @* Show only faults that block the asset *@
                            @if (hasBlockingFaults)
                            {
                                <p class="text-danger text-center mb-1"><strong>Faults – asset disabled:</strong></p>
                                <ul class="list-unstyled text-center small text-danger">
                                    @foreach (var f in blockingFaults)
                                    {
                                        <li>@f.Description</li>
                                    }
                                </ul>
                            }
                        </div>

                        @if (isAvailable)
                        {
                            <!-- przycisk rezerwacji -->
                            <div class="d-flex justify-content-center">
                                <a asp-area="Employee" asp-controller="Home" asp-action="Create"
                                   asp-route-assetTag="@asset.AssetTag"
                                   asp-route-startDate="@ViewBag.StartDate.ToString("yyyy-MM-ddTHH:mm")"
                                   asp-route-endDate="@ViewBag.EndDate.ToString("yyyy-MM-ddTHH:mm")"
                                   class="btn btn-primary shadow w-100">
                                    <i class="bi bi-check-all"></i> RESERVE
                                </a>
                            </div>
                        }
                        else if (hasBlockingFaults)
                        {
                            <!-- blocking faults -->
                            <div class="text-center mt-2 small text-danger">
                                Asset has faults that prevent use
                            </div>
                        }
                        else
                        {
                            <!-- reservation conflict -->
                            <div class="text-center mt-2 small text-muted">
                                Unavailable in selected time
                            </div>
                        }

                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function submitDateForm() {
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;
            if (startDate && endDate && new Date(startDate) > new Date(endDate)) {
                const errorElement = document.getElementById('dateError');
                errorElement.classList.remove('d-none');
                return;
            }
            document.getElementById('dateFilterForm').submit();
        }

        document.getElementById('startDate').addEventListener('change', submitDateForm);
        document.getElementById('endDate').addEventListener('change', submitDateForm);

        $(document).ready(function () {
            var pendingPickup = '@ViewBag.PendingPickupReservationId';
            var pendingReturn = '@ViewBag.PendingReturnReservationId';

            if (pendingPickup) {
                Swal.fire({
                    title: 'Pickup feedback',
                    text: 'You have a reservation without pickup feedback. Would you like to provide it now?',
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, give feedback',
                    cancelButtonText: 'Skip'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("PickupFeedback", "Home", new { reservationId = ViewBag.PendingPickupReservationId })';
                    } else if (pendingReturn) {
                        Swal.fire({
                            title: 'Return feedback',
                            text: 'You have a reservation without return feedback. Would you like to provide it now?',
                            icon: 'info',
                            showCancelButton: true,
                            confirmButtonText: 'Yes, give feedback',
                            cancelButtonText: 'Skip'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                window.location.href = '@Url.Action("ReturnFeedback", "Home", new { reservationId = ViewBag.PendingReturnReservationId })';
                            }
                        });
                    }
                });
            }
            else if (pendingReturn) {
                Swal.fire({
                    title: 'Return feedback',
                    text: 'You have a reservation without return feedback. Would you like to provide it now?',
                    icon: 'info',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, give feedback',
                    cancelButtonText: 'Skip'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("ReturnFeedback", "Home", new { reservationId = ViewBag.PendingReturnReservationId })';
                    }
                });
            }
        });
    </script>
}
