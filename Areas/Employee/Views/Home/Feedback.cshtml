@model ReservationApp.Models.Reservation
@{
    string feedbackType = ViewBag.FeedbackType as string ?? "Pickup";
    string formAction = feedbackType == "Pickup" ? "PickupFeedback" : "ReturnFeedback";
    string title = feedbackType == "Pickup" ? "Pickup Feedback" : "Return Feedback";
    ViewData["Title"] = title;
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0">@title</h3>
        </div>
        <div class="card-body">
            <p><strong>Asset Tag:</strong> @Model.AssetTag</p>
            <p>
                <strong>Reservation date:</strong>
                from @Model.PickupDate.ToString("dd-MM-yyyy HH:mm")
                to @Model.ReturnDate.ToString("dd-MM-yyyy HH:mm")
            </p>
            <form asp-action="@formAction" method="post">
                <input type="hidden" name="reservationId" value="@Model.Id" />
                <div class="mb-3">
                    <label class="form-label">Is the asset damaged?</label>
                    <div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="isAssetDamaged" id="dirtyYes" value="true" required />
                            <label class="form-check-label" for="dirtyYes">Yes, it's damaged</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="isAssetDamaged" id="dirtyNo" value="false" />
                            <label class="form-check-label" for="dirtyNo">No, it's not damaged</label>
                        </div>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Fault description (optional):</label>
                    <div class="mb-3">
                        
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="hasFaults" name="hasFaults" value="true" onchange="toggleFaultArea(this.checked)">
                            <label class="form-check-label" for="hasFaults">I'm reporting faults</label>
                        </div>

                        <input type="hidden" name="hasFaults" value="false" />

                        <div id="faultWrapper" class="mt-2 d-none">
                            <label for="faults" class="form-label">Fault description:</label>
                            <textarea name="faults" id="faults" class="form-control" rows="3" placeholder="Describe faults..."></textarea>
                        </div>
                    </div>
                </div>
                @if (feedbackType == "Pickup")
                {
                    <div class="mb-3">
                        <label class="form-label" for="pickupMileage">Usage count (km)</label>
                        <input type="number" class="form-control" id="pickupMileage" name="pickupMileage" min="0" value="@Model.Asset.UsageCount" required />
                        <small class="form-text text-muted">
                            Accuracy required ± 10 km
                        </small>
                    </div>
                }

                @if (feedbackType == "Return")
                {
                    <div class="mb-3">
                        <label class="form-label" for="returnMileage">Return usage count</label>
                        <input type="number" class="form-control" id="returnMileage" name="returnMileage" min="0" value="@Model.Asset.UsageCount" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="conditionLevel">Condition [%]</label>
                        <input type="range" class="form-range" id="conditionLevel" name="conditionLevel" min="0" max="100" value="50" oninput="document.getElementById('conditionDisplay').innerText = this.value + '%'" />
                        <div class="progress mt-2" style="height: 20px;">
                            <div id="conditionProgress" class="progress-bar bg-success" role="progressbar" style="width:50%">
                                50%
                            </div>
                        </div>
                        <small id="conditionDisplay" class="form-text text-muted">50%</small>
                    </div>
                }
                <button type="submit" class="btn btn-primary">Save feedback</button>
            </form>
        </div>
    </div>
</div>

<script>
    const conditionSlider = document.getElementById('conditionLevel');
    const conditionProgress = document.getElementById('conditionProgress');
    const conditionDisplay = document.getElementById('conditionDisplay');

    function toggleFaultArea(show){
        const w = document.getElementById('faultWrapper');
        const t = document.getElementById('faults');
        w.classList.toggle('d-none', !show);
        t.required = show;
    }

    conditionSlider.addEventListener('input', function() {
        conditionProgress.style.width = this.value + "%";
        conditionProgress.innerText = this.value + "%";

        if (this.value < 25) conditionProgress.className = "progress-bar bg-danger";
        else if (this.value < 60) conditionProgress.className = "progress-bar bg-warning";
        else conditionProgress.className = "progress-bar bg-success";

        conditionDisplay.innerText = this.value + "%";
    });
</script>