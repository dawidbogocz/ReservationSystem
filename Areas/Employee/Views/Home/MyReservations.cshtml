@model IEnumerable<ReservationApp.Models.Reservation>

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-secondary bg-gradient ml-0 py-3">
        <h2 class="text-white py-2 text-center">My Reservations</h2>
    </div>

    @if (!Model.Any())
    {
        <p class="text-center text-secondary">You don't have any reservations yet.</p>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-8">
                <table class="table table-striped text-center">
                    <thead>
                        <tr>
                            <th>Registration Number</th>
                            <th>Pickup Date</th>
                            <th>Return Date</th>
                            <th>Status</th>
                            <th>Approved By</th>
                            <th>Decision Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reservation in Model)
                        {
                            <tr>
                                <td>@reservation.AssetTag</td>
                                <td data-order="@reservation.PickupDate.ToString("yyyy-MM-dd HH:mm")">
                                    @reservation.PickupDate.ToString("dd-MM-yyyy HH:mm")
                                </td>
                                <td data-order="@reservation.ReturnDate.ToString("yyyy-MM-dd HH:mm")">
                                    @reservation.ReturnDate.ToString("dd-MM-yyyy HH:mm")
                                </td>
                                <td>
                                    <span class="badge @(reservation.Approval == Approval.Accepted ? "bg-success" :
                                                    reservation.Approval == Approval.Rejected ? "bg-danger" :
                                                    reservation.Approval == Approval.Cancelled ? "bg-secondary" : "bg-warning")">
                                        @reservation.Approval.ToString()
                                    </span>
                                </td>
                                <td>@(string.IsNullOrEmpty(reservation.ApprovedBy) ? "-" : reservation.ApprovedBy)</td>
                                <td data-order="@(reservation.ApprovalDate?.ToString("yyyy-MM-dd HH:mm") ?? "0")">
                                    @(reservation.ApprovalDate?.ToString("dd-MM-yyyy HH:mm") ?? "-")
                                </td>
                                <td>
                                    @if (reservation.Approval == Approval.Accepted && DateTime.Now >= reservation.PickupDate && DateTime.Now < reservation.ReturnDate)
                                    {
                                        <a asp-action="ExtendReservation" asp-route-id="@reservation.Id" class="btn btn-sm btn-primary">Extend</a>
                                        <button type="button" class="btn btn-sm btn-danger" onclick="endEarlyReservation(@reservation.Id)">End early</button>
                                    }
                                    @if (DateTime.Now < reservation.PickupDate && reservation.Approval != Approval.Cancelled)
                                    {
                                        <button type="button" class="btn btn-sm btn-danger" onclick="openReasonModal(@reservation.Id, 'cancel')">Cancel</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Reusable Reason Modal -->
<div class="modal fade" id="reasonModal" tabindex="-1" aria-labelledby="reasonModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="reasonForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="reasonModalLabel">Reason</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="reservationId" />
                    <input type="hidden" id="formAction" />

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="isDirty">
                        <label class="form-check-label" for="isDirty">The car was dirty</label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="hasFaults">
                        <label class="form-check-label" for="hasFaults">Has faults</label>
                    </div>
                    <div class="mb-3 d-none" id="faultsGroup">
                        <label for="faultsText" class="form-label">Fault description</label>
                        <input type="text" class="form-control" id="faultsText" placeholder="Enter fault description">
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="hasOther">
                        <label class="form-check-label" for="hasOther">Other reason</label>
                    </div>
                    <div class="mb-3 d-none" id="otherGroup">
                        <label for="otherText" class="form-label">Specify other reason</label>
                        <input type="text" class="form-control" id="otherText" placeholder="Enter reason">
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger" id="submitReasonBtn">Confirm</button>
                </div>
            </form>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        // Checkbox reveal logic
        $('#hasFaults').change(function () {
            $('#faultsGroup').toggleClass('d-none', !this.checked);
        });
        $('#hasOther').change(function () {
            $('#otherGroup').toggleClass('d-none', !this.checked);
        });

        // Open modal dynamically
        function openReasonModal(reservationId, actionType) {
            $('#reservationId').val(reservationId);
            $('#formAction').val(actionType);

            // Reset modal
            $('#reasonForm')[0].reset();
            $('#faultsGroup, #otherGroup').addClass('d-none');

            const modalTitle = actionType === 'cancel' ? 'Cancellation reason' : 'Early termination reason';
            const btnText = actionType === 'cancel' ? 'Cancel' : 'End';

            $('#reasonModalLabel').text(modalTitle);
            $('#submitReasonBtn').text(btnText);

            new bootstrap.Modal(document.getElementById('reasonModal')).show();
        }

        // Submit
        $('#reasonForm').submit(function (e) {
            e.preventDefault();

            const id = $('#reservationId').val();
            const action = $('#formAction').val();
            const isDirty = $('#isDirty').is(':checked');
            const hasFaults = $('#hasFaults').is(':checked');
            const faultsText = $('#faultsText').val();
            const otherText = $('#otherText').val();

            const url = action === 'cancel'
                ? `/Employee/Home/CancelReservation/${id}`
                : `/Employee/Home/EndEarlyReservation/${id}`;

            const data = {
                isCarDirty: isDirty,
                hasFaults: hasFaults,
                faultsDescription: faultsText,
                otherReason: otherText
            };

            $.post(url, data, function (response) {
                $('#reasonModal').modal('hide');
                Swal.fire(response.success ? 'Success' : 'Error', response.message, response.success ? 'success' : 'error')
                    .then(() => location.reload());
            }).fail(function () {
                Swal.fire('Error', 'Something went wrong.', 'error');
            });
        });

        function endEarlyReservation(id) {
            Swal.fire({
                title: 'Confirm end of reservation',
                text: 'Are you sure you want to end the reservation early?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Yes, end it',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/Employee/Home/EndEarlyReservation/${id}`,
                        type: 'POST',
                        success: function (response) {
                            if (response.success) {
                                Swal.fire('Success', response.message, 'success')
                                .then(() => {
                                    // Optionally reload the page or update the reservations list
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'An error occurred while processing the reservation.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
